programa
{

	funcao inicio()
	{
		cadeia nome
		real idade
		escreva ("\nDigite seu nome: ")
		leia (nome)
		
		escreva ("Olá, ")
		escreva (nome)
		
		escreva ("\nQual sua idade? ")
