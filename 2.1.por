programa {
  funcao inicio() {
    
inteiro numero1, numero2

escreva("Escolha um número:")
leia (numero1)
escreva("Escolha outro número:")
leia (numero2)

se (numero1 > numero2){
  escreva ("O número ",numero1," é o maior")
}
se (numero2 > numero1){
  escreva ("O número ",numero2," é o maior")
}
  }
}
