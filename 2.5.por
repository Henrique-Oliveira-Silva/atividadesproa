programa {
  funcao inicio() {
    real n1,n2,n3,n4,n5,n6,res

  escreva("Digite um número: ")
  leia(n1)
  escreva("Digite outro número: ")
  leia(n2)
  escreva("Digite outro número: ")
  leia(n3)
  escreva("Digite outro número: ")
  leia(n4)
  escreva("Digite outro número: ")
  leia(n5)
  escreva("Digite outro número: ")
  leia(n6)

  res = (n1+n2+n3+n4+n5+n6)/6

  escreva("Você digitou os seguintes números: ",n1,",",n2,",",n3,",",n4,",",n5,",",n6," e a média aritimética entre eles é ",res)


  }
}
